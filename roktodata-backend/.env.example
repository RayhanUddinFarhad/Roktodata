NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/roktodata
# Atlas: MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/roktodata?retryWrites=true&w=majority
# Comma-separated list of frontends allowed to call the API
CLIENT_ORIGIN=http://localhost:3000
# Set to the number of proxies in front of the app in production (e.g. 1 behind Nginx/Render)
TRUST_PROXY=0

# "true" = donors confirm their number with an SMS code before registering or updating
REQUIRE_PHONE_VERIFICATION=true

# Admin panel login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=8h

# sms.net.bd (Alpha SMS) API key for verification codes. Leave empty locally to print codes in the server log.
SMS_NET_BD_API_KEY=
# Approved sender ID (optional)
SMS_SENDER_ID=Roktodata
# Site-wide cap on verification SMS per 24 hours
OTP_DAILY_LIMIT=300
