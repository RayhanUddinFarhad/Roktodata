NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/roktodata
# Atlas: MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/roktodata?retryWrites=true&w=majority
# Comma-separated list of frontends allowed to call the API
CLIENT_ORIGIN=http://localhost:3000
# Used to verify Firebase ID tokens from the frontend (no service account needed)
FIREBASE_PROJECT_ID=roktodata-a4325
# Set to the number of proxies in front of the app in production (e.g. 1 behind Nginx/Render)
TRUST_PROXY=0

# "false" = donors register with just a phone number (no Firebase SMS login)
REQUIRE_PHONE_VERIFICATION=true

# Admin panel login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=8h
